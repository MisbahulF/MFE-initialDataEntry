import React, { useState } from 'react';
import { useAuth } from '@template/shared';
import {
  FileCheck2,
  CheckCircle2,
  Send,
  RotateCcw,
  ArrowLeft,
  Save,
  Check,
  AlertTriangle,
  Building,
  User,
  CreditCard,
  Phone,
  Briefcase,
  Home,
  ShieldCheck,
  FileText,
  DollarSign,
  Layers,
  X,
  Sparkles,
} from 'lucide-react';
import { dataEntryService, type DataEntryRecord } from '../services/dataEntryData';

interface DataEntryFormProps {
  application: DataEntryRecord;
  onBackToList: () => void;
  onApplicationUpdated: (updated: DataEntryRecord) => void;
}

export const DataEntryForm: React.FC<DataEntryFormProps> = ({
  application,
  onBackToList,
  onApplicationUpdated,
}) => {
  const { user } = useAuth();
  const [activeTab, setActiveTab] = useState<'pembiayaan' | 'debitur' | 'keuangan' | 'agunan' | 'memo'>('pembiayaan');

  // Form State initialized with Sales IDE data
  const [formData, setFormData] = useState<DataEntryRecord>({ ...application });
  const [checklist, setChecklist] = useState({
    ktpValid: application.docChecklist?.ktpValid ?? true,
    kkValid: application.docChecklist?.kkValid ?? true,
    npwpValid: application.docChecklist?.npwpValid ?? true,
    slipGajiValid: application.docChecklist?.slipGajiValid ?? true,
    rekKoranValid: application.docChecklist?.rekKoranValid ?? true,
    agunanValid: application.docChecklist?.agunanValid ?? true,
  });

  const [toastMessage, setToastMessage] = useState<string | null>(null);
  const [showRtsModal, setShowRtsModal] = useState(false);
  const [rtsReason, setRtsReason] = useState('');

  const handleSaveDraft = () => {
    const updated: DataEntryRecord = {
      ...formData,
      status: 'In Progress DE',
      docChecklist: checklist,
    };
    dataEntryService.updateRecord(updated);
    setFormData(updated);
    onApplicationUpdated(updated);
    showToast('Draft Data Entry berhasil disimpan!');
  };

  const handleKirimKeAnalis = () => {
    // Validasi checklist dokumen
    const allChecked = Object.values(checklist).every(Boolean);
    if (!allChecked) {
      const confirmSend = window.confirm(
        'Perhatian: Beberapa checklist dokumen belum diverifikasi valid. Apakah Anda yakin ingin tetap meneruskan berkas ke Analis Kredit / SPV CA?'
      );
      if (!confirmSend) return;
    }

    const updated: DataEntryRecord = {
      ...formData,
      status: 'DE Selesai',
      docChecklist: checklist,
    };
    dataEntryService.updateRecord(updated);
    setFormData(updated);
    onApplicationUpdated(updated);
    showToast('Data Entry tuntas! Berkas berhasil diteruskan ke Analis Kredit (CA) & SPV CA untuk Verifikasi & Scoring.');
    setTimeout(() => {
      onBackToList();
    }, 1800);
  };

  const handleReturnToSales = () => {
    if (!rtsReason.trim()) {
      alert('Silakan masukkan alasan pengembalian berkas ke Sales.');
      return;
    }

    const updated: DataEntryRecord = {
      ...formData,
      status: 'Return to Sales (RTS)',
      catatanProcessing: `[RTS dari Processing]: ${rtsReason}\n` + (formData.catatanProcessing || ''),
    };
    dataEntryService.updateRecord(updated);
    setFormData(updated);
    onApplicationUpdated(updated);
    setShowRtsModal(false);
    showToast('Berkas berhasil dikembalikan ke Sales untuk perbaikan data!');
    setTimeout(() => {
      onBackToList();
    }, 1500);
  };

  const showToast = (msg: string) => {
    setToastMessage(msg);
    setTimeout(() => setToastMessage(null), 4000);
  };

  return (
    <div className="min-h-screen bg-slate-50 font-sans text-slate-800 flex flex-col justify-between pb-24">
      {/* ========================================================
          1. HEADER FORM DATA ENTRY (BNI Cubesh eLO)
      ======================================================== */}
      <div className="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-2xs">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 py-2.5 flex items-center justify-between">
          <div className="flex items-center gap-3">
            <button
              type="button"
              onClick={onBackToList}
              className="p-1.5 rounded-lg border border-slate-200 hover:bg-slate-50 text-slate-600 transition-colors cursor-pointer"
              title="Kembali ke Antrean DE"
            >
              <ArrowLeft className="h-4 w-4" />
            </button>
            <div>
              <div className="flex items-center gap-2">
                <span className="font-black text-xl tracking-tight text-[#e65100]">BNI</span>
                <span className="text-xs font-bold text-teal-800">
                  Data Entry : <strong className="text-slate-900">{formData.namaDebitur}</strong>
                </span>
                <span className="text-[10px] font-mono px-2 py-0.5 rounded bg-teal-50 text-teal-800 border border-teal-200 font-bold">
                  {formData.noAplikasi}
                </span>
              </div>
              <p className="text-[11px] text-slate-500">
                Fasilitas: <strong>{formData.fasilitas}</strong> &bull; Plafond: <strong>{formData.maksKredit}</strong> &bull; Pengirim Sales: <strong>{formData.salesName}</strong>
              </p>
            </div>
          </div>

          <div className="flex items-center gap-2">
            <span
              className={`px-3 py-1 rounded-full text-xs font-bold ${
                formData.status === 'Menunggu Data Entry'
                  ? 'bg-orange-100 text-orange-800 border border-orange-200'
                  : formData.status === 'In Progress DE'
                  ? 'bg-blue-100 text-blue-800 border border-blue-200'
                  : 'bg-emerald-100 text-emerald-800 border border-emerald-200'
              }`}
            >
              {formData.status}
            </span>
          </div>
        </div>

        {/* TAB NAVIGATION STRIP */}
        <div className="bg-[#008080] text-white px-4 sm:px-6 shadow-md overflow-x-auto">
          <div className="max-w-7xl mx-auto flex items-center gap-1 text-xs font-bold">
            {[
              { id: 'pembiayaan', label: '1. Pembiayaan & Sales', icon: DollarSign },
              { id: 'debitur', label: '2. Debitur & Checklist Dokumen', icon: User },
              { id: 'keuangan', label: '3. Data Keuangan & DSR', icon: Briefcase },
              { id: 'agunan', label: '4. Agunan & Taksasi Awal', icon: Home },
              { id: 'memo', label: '5. Catatan & Review Processing', icon: FileText },
            ].map((t) => {
              const IconComponent = t.icon;
              return (
                <button
                  key={t.id}
                  type="button"
                  onClick={() => setActiveTab(t.id as any)}
                  className={`px-4 py-2.5 flex items-center gap-1.5 transition-all cursor-pointer whitespace-nowrap border-b-2 ${
                    activeTab === t.id
                      ? 'bg-white text-teal-900 border-amber-400 shadow-xs'
                      : 'text-teal-100 hover:bg-[#006666] border-transparent'
                  }`}
                >
                  <IconComponent className="h-3.5 w-3.5" />
                  <span>{t.label}</span>
                </button>
              );
            })}
          </div>
        </div>
      </div>

      {/* ========================================================
          2. ISI TAB FORMULIR DATA ENTRY
      ======================================================== */}
      <div className="max-w-7xl mx-auto w-full p-4 sm:p-6 space-y-6 flex-1">
        {/* Toast Notifikasi */}
        {toastMessage && (
          <div className="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-900 text-xs font-semibold flex items-center justify-between shadow-sm animate-fade-in">
            <div className="flex items-center gap-2">
              <CheckCircle2 className="h-5 w-5 text-emerald-600 shrink-0" />
              <span>{toastMessage}</span>
            </div>
            <button
              type="button"
              onClick={() => setToastMessage(null)}
              className="text-emerald-700 hover:text-emerald-900 cursor-pointer"
            >
              <X className="h-4 w-4" />
            </button>
          </div>
        )}

        {/* TAB 1: PEMBIAYAAN & SALES SOURCE */}
        {activeTab === 'pembiayaan' && (
          <div className="space-y-6 animate-fade-in">
            <div className="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm space-y-4">
              <div className="pb-3 border-b border-slate-100 flex items-center justify-between">
                <h3 className="text-sm font-bold text-slate-900 uppercase tracking-wide flex items-center gap-2">
                  <DollarSign className="h-4 w-4 text-teal-600" />
                  STRUKTUR PEMBIAYAAN KREDIT (HASIL KIRIM APLIKASI DARI SALES)
                </h3>
                <span className="text-[11px] text-slate-400">Data otomatis terisi dari formulir IDE</span>
              </div>

              <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 text-xs">
                <div>
                  <label className="block font-semibold text-slate-600 mb-1">No. Aplikasi (Processing):</label>
                  <input
                    type="text"
                    readOnly
                    value={formData.noAplikasi}
                    className="w-full px-3 py-2 rounded-xl bg-slate-100 border border-slate-200 font-mono font-bold text-teal-800"
                  />
                </div>

                <div>
                  <label className="block font-semibold text-slate-600 mb-1">No. Prospek (Sales IDE):</label>
                  <input
                    type="text"
                    readOnly
                    value={formData.noProspek}
                    className="w-full px-3 py-2 rounded-xl bg-slate-100 border border-slate-200 font-mono text-slate-700"
                  />
                </div>

                <div>
                  <label className="block font-semibold text-slate-600 mb-1">Produk Pinjaman:</label>
                  <input
                    type="text"
                    readOnly
                    value={formData.produk}
                    className="w-full px-3 py-2 rounded-xl bg-slate-100 border border-slate-200 font-bold text-slate-900"
                  />
                </div>

                <div className="md:col-span-2">
                  <label className="block font-semibold text-slate-600 mb-1">Nama Fasilitas:</label>
                  <input
                    type="text"
                    value={formData.fasilitas}
                    onChange={(e) => setFormData({ ...formData, fasilitas: e.target.value })}
                    className="w-full px-3 py-2 rounded-xl border border-slate-300 focus:ring-2 focus:ring-teal-500 font-medium"
                  />
                </div>

                <div>
                  <label className="block font-semibold text-slate-600 mb-1">Kode Program:</label>
                  <input
                    type="text"
                    value={formData.kodeProgram}
                    onChange={(e) => setFormData({ ...formData, kodeProgram: e.target.value })}
                    className="w-full px-3 py-2 rounded-xl border border-slate-300 focus:ring-2 focus:ring-teal-500 font-medium"
                  />
                </div>

                <div>
                  <label className="block font-semibold text-slate-600 mb-1">Maksimum Kredit (Plafond):</label>
                  <input
                    type="text"
                    value={formData.maksKredit}
                    onChange={(e) => setFormData({ ...formData, maksKredit: e.target.value })}
                    className="w-full px-3 py-2 rounded-xl border border-slate-300 focus:ring-2 focus:ring-teal-500 font-mono font-bold text-orange-600"
                  />
                </div>

                <div>
                  <label className="block font-semibold text-slate-600 mb-1">Suku Bunga Indikasi:</label>
                  <input
                    type="text"
                    value={formData.sukuBunga}
                    onChange={(e) => setFormData({ ...formData, sukuBunga: e.target.value })}
                    className="w-full px-3 py-2 rounded-xl border border-slate-300 focus:ring-2 focus:ring-teal-500 font-medium"
                  />
                </div>

                <div>
                  <label className="block font-semibold text-slate-600 mb-1">Jangka Waktu (Tenor):</label>
                  <input
                    type="text"
                    value={formData.jangkaWaktu}
                    onChange={(e) => setFormData({ ...formData, jangkaWaktu: e.target.value })}
                    className="w-full px-3 py-2 rounded-xl border border-slate-300 focus:ring-2 focus:ring-teal-500 font-medium"
                  />
                </div>
              </div>
            </div>

            {/* INFORMASI PETUGAS SALES PENGIRIM */}
            <div className="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm space-y-4">
              <div className="pb-3 border-b border-slate-100 flex items-center justify-between">
                <h3 className="text-sm font-bold text-slate-900 uppercase tracking-wide flex items-center gap-2">
                  <User className="h-4 w-4 text-orange-600" />
                  INFORMASI SALES OFFICER PENGIRIM (SOURCE APLIKASI)
                </h3>
                <span className="text-[11px] text-slate-400">Unit Sales Originator</span>
              </div>

              <div className="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
                <div>
                  <label className="block font-semibold text-slate-500 mb-1">Nama Petugas Sales:</label>
                  <div className="p-3 bg-slate-50 rounded-xl font-bold text-slate-900 border border-slate-200">
                    {formData.salesName}
                  </div>
                </div>

                <div>
                  <label className="block font-semibold text-slate-500 mb-1">User ID Sales:</label>
                  <div className="p-3 bg-slate-50 rounded-xl font-mono font-bold text-orange-600 border border-slate-200">
                    {formData.salesId}
                  </div>
                </div>

                <div>
                  <label className="block font-semibold text-slate-500 mb-1">Cabang / Sales Point:</label>
                  <div className="p-3 bg-slate-50 rounded-xl font-medium text-slate-800 border border-slate-200">
                    {formData.cabang}
                  </div>
                </div>
              </div>
            </div>
          </div>
        )}

        {/* TAB 2: DATA DEBITUR & CHECKLIST DOKUMEN */}
        {activeTab === 'debitur' && (
          <div className="space-y-6 animate-fade-in">
            {/* IDENTITAS CALON DEBITUR */}
            <div className="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm space-y-4">
              <div className="pb-3 border-b border-slate-100 flex items-center justify-between">
                <h3 className="text-sm font-bold text-slate-900 uppercase tracking-wide flex items-center gap-2">
                  <User className="h-4 w-4 text-teal-600" />
                  DATA IDENTITAS CALON DEBITUR (TERVERIFIKASI)
                </h3>
                <span className="text-[11px] text-slate-400">Validasi NIK &amp; Data Kependudukan</span>
              </div>

              <div className="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
                <div>
                  <label className="block font-semibold text-slate-600 mb-1">Nama Lengkap Debitur:</label>
                  <input
                    type="text"
                    value={formData.namaDebitur}
                    onChange={(e) => setFormData({ ...formData, namaDebitur: e.target.value })}
                    className="w-full px-3 py-2 rounded-xl border border-slate-300 focus:ring-2 focus:ring-teal-500 font-bold text-slate-900"
                  />
                </div>

                <div>
                  <label className="block font-semibold text-slate-600 mb-1">No. KTP (NIK):</label>
                  <input
                    type="text"
                    value={formData.ktp}
                    onChange={(e) => setFormData({ ...formData, ktp: e.target.value })}
                    className="w-full px-3 py-2 rounded-xl border border-slate-300 focus:ring-2 focus:ring-teal-500 font-mono font-medium"
                  />
                </div>

                <div>
                  <label className="block font-semibold text-slate-600 mb-1">No. NPWP Pribadi:</label>
                  <input
                    type="text"
                    value={formData.npwp}
                    onChange={(e) => setFormData({ ...formData, npwp: e.target.value })}
                    className="w-full px-3 py-2 rounded-xl border border-slate-300 focus:ring-2 focus:ring-teal-500 font-mono font-medium"
                  />
                </div>

                <div>
                  <label className="block font-semibold text-slate-600 mb-1">No. Telepon / Handphone:</label>
                  <input
                    type="text"
                    value={formData.telepon}
                    onChange={(e) => setFormData({ ...formData, telepon: e.target.value })}
                    className="w-full px-3 py-2 rounded-xl border border-slate-300 focus:ring-2 focus:ring-teal-500 font-medium"
                  />
                </div>

                <div className="md:col-span-2">
                  <label className="block font-semibold text-slate-600 mb-1">Alamat Sesuai KTP:</label>
                  <input
                    type="text"
                    value={formData.alamatKtp}
                    onChange={(e) => setFormData({ ...formData, alamatKtp: e.target.value })}
                    className="w-full px-3 py-2 rounded-xl border border-slate-300 focus:ring-2 focus:ring-teal-500 font-medium"
                  />
                </div>
              </div>
            </div>

            {/* INFORMASI PASANGAN & KONTAK DARURAT (DARI IDE) */}
            {(formData.namaPasangan || formData.namaEmergency) && (
              <div className="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm space-y-4">
                <div className="pb-3 border-b border-slate-100 flex items-center justify-between">
                  <h3 className="text-sm font-bold text-slate-900 uppercase tracking-wide flex items-center gap-2">
                    <User className="h-4 w-4 text-pink-600" />
                    DATA PASANGAN &amp; KONTAK DARURAT (INPUT FORMULIR IDE)
                  </h3>
                  <span className="text-[11px] text-slate-400">Data Keluarga &amp; Referensi Kontak</span>
                </div>

                <div className="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
                  {formData.namaPasangan && (
                    <div className="p-3.5 bg-slate-50 rounded-xl border border-slate-200 space-y-1">
                      <div className="text-[11px] font-bold text-slate-500 uppercase">Data Pasangan (Istri / Suami)</div>
                      <div className="font-bold text-slate-900 text-sm">{formData.namaPasangan}</div>
                      {formData.ktpPasangan && (
                        <div className="text-slate-600 font-mono text-[11px]">NIK: {formData.ktpPasangan}</div>
                      )}
                      {formData.pekerjaanPasangan && (
                        <div className="text-slate-600 text-[11px]">Pekerjaan: {formData.pekerjaanPasangan}</div>
                      )}
                    </div>
                  )}

                  {formData.namaEmergency && (
                    <div className="p-3.5 bg-slate-50 rounded-xl border border-slate-200 space-y-1">
                      <div className="text-[11px] font-bold text-slate-500 uppercase">Kontak Darurat (Emergency)</div>
                      <div className="font-bold text-slate-900 text-sm">{formData.namaEmergency}</div>
                      {formData.hubunganEmergency && (
                        <div className="text-slate-600 text-[11px]">Hubungan: {formData.hubunganEmergency}</div>
                      )}
                      {formData.telpEmergency && (
                        <div className="text-slate-600 font-mono text-[11px]">Telepon: {formData.telpEmergency}</div>
                      )}
                    </div>
                  )}
                </div>
              </div>
            )}

            {/* CHECKLIST VERIFIKASI DOKUMEN MASUK DARI SALES */}
            <div className="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm space-y-4">
              <div className="pb-3 border-b border-slate-100 flex items-center justify-between">
                <h3 className="text-sm font-bold text-slate-900 uppercase tracking-wide flex items-center gap-2">
                  <FileCheck2 className="h-4 w-4 text-emerald-600" />
                  CHECKLIST VERIFIKASI DOKUMEN FISIK &amp; DIGITAL MASUK DARI SALES
                </h3>
                <span className="text-[11px] text-emerald-700 bg-emerald-50 px-2.5 py-0.5 rounded-full font-bold">
                  Standar Verifikasi Processing
                </span>
              </div>

              <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5 text-xs">
                {[
                  { key: 'ktpValid', label: '1. KTP Pemohon Asli & Jelas', sub: 'Terdaftar Dukcapil & Masih Berlaku' },
                  { key: 'kkValid', label: '2. Kartu Keluarga (KK)', sub: 'Terverifikasi status perkawinan/tanggungan' },
                  { key: 'npwpValid', label: '3. NPWP Pribadi Valid', sub: 'Wajib untuk plafond > Rp 50 Juta' },
                  { key: 'slipGajiValid', label: '4. Slip Gaji 3 Bulan Terakhir', sub: 'Dilegalisir HRD / Surat Keterangan Kerja' },
                  { key: 'rekKoranValid', label: '5. Rekening Koran 3 Bulan', sub: 'Kesesuaian payroll & mutasi saldo' },
                  { key: 'agunanValid', label: '6. Dokumen Agunan (SHM/BPKB)', sub: 'Sertifikat, IMB, PBB tahun terakhir' },
                ].map((item) => {
                  const isChecked = (checklist as any)[item.key];
                  return (
                    <div
                      key={item.key}
                      onClick={() =>
                        setChecklist({
                          ...checklist,
                          [item.key]: !isChecked,
                        })
                      }
                      className={`p-3.5 rounded-xl border transition-all cursor-pointer flex items-start gap-3 ${
                        isChecked
                          ? 'bg-emerald-50/60 border-emerald-300 text-emerald-950 shadow-2xs'
                          : 'bg-white border-slate-200 text-slate-700 hover:border-slate-300'
                      }`}
                    >
                      <div
                        className={`h-5 w-5 rounded-md flex items-center justify-center shrink-0 mt-0.5 transition-colors ${
                          isChecked ? 'bg-emerald-600 text-white' : 'border border-slate-300 bg-white'
                        }`}
                      >
                        {isChecked && <Check className="h-3.5 w-3.5" />}
                      </div>
                      <div>
                        <div className="font-bold text-xs">{item.label}</div>
                        <div className="text-[11px] text-slate-500 mt-0.5">{item.sub}</div>
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          </div>
        )}

        {/* TAB 3: DATA KEUANGAN & DSR */}
        {activeTab === 'keuangan' && (
          <div className="space-y-6 animate-fade-in">
            <div className="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm space-y-4">
              <div className="pb-3 border-b border-slate-100 flex items-center justify-between">
                <h3 className="text-sm font-bold text-slate-900 uppercase tracking-wide flex items-center gap-2">
                  <Briefcase className="h-4 w-4 text-blue-600" />
                  DATA PEKERJAAN &amp; ANALISIS KEUANGAN AWAL (PROCESSING DATA ENTRY)
                </h3>
                <span className="text-[11px] text-slate-400">Kalkulasi Kemampuan Mengangsur</span>
              </div>

              <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 text-xs">
                <div>
                  <label className="block font-semibold text-slate-600 mb-1">Tipe Pekerjaan:</label>
                  <input
                    type="text"
                    value={formData.tipePekerjaan || ''}
                    onChange={(e) => setFormData({ ...formData, tipePekerjaan: e.target.value })}
                    className="w-full px-3 py-2 rounded-xl border border-slate-300 focus:ring-2 focus:ring-teal-500 font-medium"
                  />
                </div>

                <div className="md:col-span-2">
                  <label className="block font-semibold text-slate-600 mb-1">Nama Instansi / Perusahaan:</label>
                  <input
                    type="text"
                    value={formData.namaPerusahaan || ''}
                    onChange={(e) => setFormData({ ...formData, namaPerusahaan: e.target.value })}
                    className="w-full px-3 py-2 rounded-xl border border-slate-300 focus:ring-2 focus:ring-teal-500 font-bold text-slate-900"
                  />
                </div>

                <div>
                  <label className="block font-semibold text-slate-600 mb-1">Jabatan / Posisi:</label>
                  <input
                    type="text"
                    value={formData.jabatan || ''}
                    onChange={(e) => setFormData({ ...formData, jabatan: e.target.value })}
                    className="w-full px-3 py-2 rounded-xl border border-slate-300 focus:ring-2 focus:ring-teal-500 font-medium"
                  />
                </div>

                <div>
                  <label className="block font-semibold text-slate-600 mb-1">Gaji Pokok / THP (Rp):</label>
                  <input
                    type="text"
                    value={formData.gajiPokok || ''}
                    onChange={(e) => setFormData({ ...formData, gajiPokok: e.target.value })}
                    className="w-full px-3 py-2 rounded-xl border border-slate-300 focus:ring-2 focus:ring-teal-500 font-mono font-bold text-emerald-700"
                  />
                </div>

                <div>
                  <label className="block font-semibold text-slate-600 mb-1">Pendapatan Lain / Pasangan:</label>
                  <input
                    type="text"
                    value={formData.pendapatanLain || ''}
                    onChange={(e) => setFormData({ ...formData, pendapatanLain: e.target.value })}
                    className="w-full px-3 py-2 rounded-xl border border-slate-300 focus:ring-2 focus:ring-teal-500 font-mono"
                  />
                </div>

                <div>
                  <label className="block font-semibold text-slate-600 mb-1">Total Biaya Hidup &amp; Angsuran Lain:</label>
                  <input
                    type="text"
                    value={formData.totalPengeluaran || ''}
                    onChange={(e) => setFormData({ ...formData, totalPengeluaran: e.target.value })}
                    className="w-full px-3 py-2 rounded-xl border border-slate-300 focus:ring-2 focus:ring-teal-500 font-mono text-red-600"
                  />
                </div>

                <div>
                  <label className="block font-semibold text-slate-600 mb-1">Indikasi DSR (Debt Service Ratio):</label>
                  <input
                    type="text"
                    value={formData.dsrPersen || ''}
                    onChange={(e) => setFormData({ ...formData, dsrPersen: e.target.value })}
                    className="w-full px-3 py-2 rounded-xl border border-slate-300 focus:ring-2 focus:ring-teal-500 font-mono font-bold text-blue-700"
                  />
                </div>

                {formData.noRekeningPayroll && (
                  <div className="md:col-span-2">
                    <label className="block font-semibold text-slate-600 mb-1">Rekening Payroll BNI (Data Input IDE):</label>
                    <input
                      type="text"
                      readOnly
                      value={`${formData.namaBankPayroll || 'BNI'} - ${formData.noRekeningPayroll}`}
                      className="w-full px-3 py-2 rounded-xl bg-slate-100 border border-slate-200 font-mono font-bold text-teal-800"
                    />
                  </div>
                )}
              </div>
            </div>
          </div>
        )}

        {/* TAB 4: AGUNAN & PENILAIAN */}
        {activeTab === 'agunan' && (
          <div className="space-y-6 animate-fade-in">
            <div className="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm space-y-4">
              <div className="pb-3 border-b border-slate-100 flex items-center justify-between">
                <h3 className="text-sm font-bold text-slate-900 uppercase tracking-wide flex items-center gap-2">
                  <Home className="h-4 w-4 text-rose-600" />
                  DATA AGUNAN &amp; TAKSASI AWAL PEMBIAYAAN
                </h3>
                <span className="text-[11px] text-slate-400">Verifikasi Jaminan Pokok</span>
              </div>

              <div className="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
                <div>
                  <label className="block font-semibold text-slate-600 mb-1">Tipe Agunan:</label>
                  <input
                    type="text"
                    value={formData.tipeJaminan || 'Properti / Rumah Tinggal'}
                    onChange={(e) => setFormData({ ...formData, tipeJaminan: e.target.value })}
                    className="w-full px-3 py-2 rounded-xl border border-slate-300 focus:ring-2 focus:ring-teal-500 font-medium"
                  />
                </div>

                <div>
                  <label className="block font-semibold text-slate-600 mb-1">Nilai Taksasi Pasar (Rp):</label>
                  <input
                    type="text"
                    value={formData.nilaiPasarTaksasi || ''}
                    onChange={(e) => setFormData({ ...formData, nilaiPasarTaksasi: e.target.value })}
                    className="w-full px-3 py-2 rounded-xl border border-slate-300 focus:ring-2 focus:ring-teal-500 font-mono font-bold text-slate-900"
                  />
                </div>

                <div className="md:col-span-2">
                  <label className="block font-semibold text-slate-600 mb-1">Lokasi Agunan:</label>
                  <textarea
                    rows={2}
                    value={formData.lokasiAgunan || ''}
                    onChange={(e) => setFormData({ ...formData, lokasiAgunan: e.target.value })}
                    className="w-full px-3 py-2 rounded-xl border border-slate-300 focus:ring-2 focus:ring-teal-500 font-medium"
                  />
                </div>
              </div>
            </div>
          </div>
        )}

        {/* TAB 5: CATATAN & MEMO PROCESSING */}
        {activeTab === 'memo' && (
          <div className="space-y-6 animate-fade-in">
            {/* Memo Catatan dari Sales Originator (IDE) */}
            {formData.memoSales && (
              <div className="bg-amber-50/80 rounded-2xl border border-amber-200 p-6 shadow-sm space-y-3">
                <div className="pb-2 border-b border-amber-200/80 flex items-center justify-between">
                  <h3 className="text-sm font-bold text-amber-900 uppercase tracking-wide flex items-center gap-2">
                    <FileText className="h-4 w-4 text-amber-700" />
                    CATATAN MEMO DARI SALES ORIGINATOR (INPUT IDE)
                  </h3>
                  <span className="text-[11px] font-semibold text-amber-800 bg-amber-100 px-2.5 py-0.5 rounded-full">
                    Dari Sales: {formData.salesName}
                  </span>
                </div>
                <div className="text-xs text-slate-800 whitespace-pre-line leading-relaxed bg-white p-4 rounded-xl border border-amber-200">
                  {formData.memoSales}
                </div>
              </div>
            )}

            <div className="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm space-y-4">
              <div className="pb-3 border-b border-slate-100 flex items-center justify-between">
                <h3 className="text-sm font-bold text-slate-900 uppercase tracking-wide flex items-center gap-2">
                  <FileText className="h-4 w-4 text-teal-600" />
                  CATATAN &amp; REKOMENDASI PETUGAS DATA ENTRY
                </h3>
                <span className="text-[11px] text-slate-400">Review Pemrosesan Dokumen</span>
              </div>

              <div>
                <label className="block font-semibold text-slate-700 mb-1.5 text-xs">
                  Catatan Verifikasi Data Entry (Ditujukan kepada Analis Kredit / SPV CA):
                </label>
                <textarea
                  rows={5}
                  value={formData.catatanProcessing || ''}
                  onChange={(e) => setFormData({ ...formData, catatanProcessing: e.target.value })}
                  placeholder="Masukkan catatan kelengkapan dokumen, konfirmasi kontak, atau instruksi khusus untuk verifikasi lapangan/SLIK..."
                  className="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-teal-500 text-xs font-medium"
                />
              </div>
            </div>
          </div>
        )}
      </div>

      {/* ========================================================
          3. FLOATING ACTION BAR BAWAH (PERSIS SISTEM eLO)
      ======================================================== */}
      <div className="fixed bottom-0 left-0 right-0 bg-white/95 backdrop-blur-md border-t border-slate-200 py-3 px-6 z-40 shadow-lg">
        <div className="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-3">
          <div className="flex items-center gap-2 text-xs">
            <button
              type="button"
              onClick={onBackToList}
              className="px-4 py-2 rounded-xl border border-slate-300 hover:bg-slate-50 text-slate-700 font-semibold cursor-pointer flex items-center gap-1.5"
            >
              <ArrowLeft className="h-4 w-4" />
              Kembali ke Antrean DE
            </button>
            <span className="text-slate-400 hidden sm:inline">|</span>
            <span className="text-slate-600 text-[11px] hidden sm:inline">
              Data Entry Officer: <strong>{user?.name || 'DINA WULANDARI'}</strong>
            </span>
          </div>

          <div className="flex items-center gap-2.5">
            <button
              type="button"
              onClick={() => setShowRtsModal(true)}
              className="px-3.5 py-2 rounded-xl bg-red-50 hover:bg-red-100 text-red-700 border border-red-200 text-xs font-bold transition-all cursor-pointer flex items-center gap-1.5"
            >
              <RotateCcw className="h-4 w-4" />
              Kembalikan ke Sales (RTS)
            </button>

            <button
              type="button"
              onClick={handleSaveDraft}
              className="px-4 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-bold transition-all cursor-pointer flex items-center gap-1.5"
            >
              <Save className="h-4 w-4" />
              Simpan Draft DE
            </button>

            <button
              type="button"
              onClick={handleKirimKeAnalis}
              className="px-5 py-2 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-700 hover:from-emerald-700 hover:to-teal-800 text-white text-xs font-bold shadow-md shadow-teal-700/20 transition-all cursor-pointer flex items-center gap-2 hover:scale-105 active:scale-95"
            >
              <Send className="h-4 w-4" />
              Kirim ke Verifikasi / Analis (CA)
            </button>
          </div>
        </div>
      </div>

      {/* MODAL RETURN TO SALES (RTS) */}
      {showRtsModal && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs animate-fade-in">
          <div className="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-200 space-y-4">
            <div className="flex items-center justify-between pb-3 border-b border-slate-100">
              <div className="flex items-center gap-2 text-red-600">
                <AlertTriangle className="h-5 w-5" />
                <h4 className="font-bold text-sm text-slate-900">Kembalikan Berkas ke Sales (RTS)</h4>
              </div>
              <button
                type="button"
                onClick={() => setShowRtsModal(false)}
                className="text-slate-400 hover:text-slate-700 cursor-pointer"
              >
                <X className="h-4 w-4" />
              </button>
            </div>

            <p className="text-xs text-slate-600 leading-relaxed">
              Berkas aplikasi ini akan dikembalikan kepada Sales (<strong>{formData.salesName}</strong>) untuk perbaikan kelengkapan data. Masukkan alasan pengembalian:
            </p>

            <textarea
              rows={4}
              value={rtsReason}
              onChange={(e) => setRtsReason(e.target.value)}
              placeholder="Contoh: Slip gaji belum dilegalisir, KTP pemohon buram, mohon input ulang..."
              className="w-full p-3 text-xs rounded-xl border border-slate-300 focus:ring-2 focus:ring-red-500 font-medium"
            />

            <div className="pt-2 flex items-center justify-end gap-2 border-t border-slate-100 text-xs">
              <button
                type="button"
                onClick={() => setShowRtsModal(false)}
                className="px-4 py-2 rounded-xl border border-slate-200 text-slate-700 font-semibold hover:bg-slate-50 cursor-pointer"
              >
                Batal
              </button>
              <button
                type="button"
                onClick={handleReturnToSales}
                className="px-4 py-2 rounded-xl bg-red-600 hover:bg-red-700 text-white font-bold cursor-pointer"
              >
                Konfirmasi RTS
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
};

export default DataEntryForm;
